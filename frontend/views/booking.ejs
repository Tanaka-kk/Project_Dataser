<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('partials/head', { title: 'Book Appointment' }) %>
</head>
<body class="bg-body-tertiary">
  <%- include('partials/navbar', { active: 'dashboard' }) %>

  <div class="container pb-5" style="max-width: 560px;">
    <div class="card page-card p-4">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="pet-avatar" style="width:56px;height:56px;font-size:1.7rem;"><i class="bi bi-calendar-plus"></i></div>
        <h4 class="mb-0">Book Appointment</h4>
      </div>
      <div id="alertBox" class="alert d-none"></div>

      <form id="bookingForm">
        <div class="mb-3">
          <label class="form-label">Pet</label>
          <select class="form-select" id="petSelect" required></select>
        </div>
        <div class="mb-3">
          <label class="form-label">Doctor</label>
          <select class="form-select" id="doctorSelect" required></select>
        </div>
        <div class="row">
          <div class="col-6 mb-3">
            <label class="form-label">Date</label>
            <input type="date" class="form-control" id="appDate" required>
          </div>
          <div class="col-6 mb-3">
            <label class="form-label">Time</label>
            <input type="time" class="form-control" id="appTime" required>
          </div>
        </div>
        <div class="mb-4">
          <label class="form-label">Reason</label>
          <textarea class="form-control" id="reason" rows="2" required></textarea>
        </div>
        <button type="submit" class="btn btn-brand w-100"><i class="bi bi-check-lg me-1"></i>Confirm Booking</button>
      </form>
    </div>
  </div>

  <%- include('partials/bottomnav', { active: 'booking' }) %>

  <script src="/js/app.js"></script>
  <script>
    const session = requireRole("user");
    document.getElementById("appDate").min = new Date().toISOString().split("T")[0];

    async function loadPets() {
      const res = await fetch(`${API_BASE}/getpets/${session.user_id}`);
      const pets = await res.json();
      const select = document.getElementById("petSelect");
      select.innerHTML = pets.length
        ? pets.map(p => `<option value="${p.pet_id}">${p.pet_name}</option>`).join("")
        : `<option value="">No pets yet — add one first</option>`;
    }

    async function loadDoctors() {
      const res = await fetch(`${API_BASE}/GetDoctors`);
      const doctors = await res.json();
      const select = document.getElementById("doctorSelect");
      select.innerHTML = doctors
        .filter(d => d.is_available)
        .map(d => `<option value="${d.doc_id}">${d.doc_name} — ${d.specialization}</option>`)
        .join("") || `<option value="">No doctors available</option>`;
    }

    document.getElementById("bookingForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const pet_id = document.getElementById("petSelect").value;
      const doc_id = document.getElementById("doctorSelect").value;

      if (!pet_id || !doc_id) {
        showAlert("alertBox", "Please make sure you have a pet and a doctor selected");
        return;
      }

      const body = {
        app_date: document.getElementById("appDate").value,
        app_time: document.getElementById("appTime").value,
        reason: document.getElementById("reason").value
      };

      const res = await fetch(`${API_BASE}/insertAppointment/${pet_id}/${session.user_id}/${doc_id}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (data.error) {
        showAlert("alertBox", data.message || "Failed to book appointment");
        return;
      }

      showAlert("alertBox", "Appointment booked!", "success");
      setTimeout(() => window.location.href = "/appointments", 900);
    });

    Promise.all([loadPets(), loadDoctors()]).catch(() => showAlert("alertBox", "Cannot reach server"));
  </script>
</body>
</html>
