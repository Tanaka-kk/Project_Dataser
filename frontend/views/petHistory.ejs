<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('partials/head', { title: 'Medical History' }) %>
</head>
<body class="bg-body-tertiary">
  <%- include('partials/navbar', { active: 'pet' }) %>

  <div class="container pb-5" style="max-width: 560px;">
    <a href="#" id="backLink" class="text-decoration-none text-muted d-inline-block mb-3">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
    <div class="card page-card p-4">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="pet-avatar" style="width:56px;height:56px;font-size:1.7rem;">🐾</div>
        <h4 class="mb-0">Medical History</h4>
      </div>
      <div id="alertBox" class="alert d-none"></div>
      <div id="recordList" class="list-group"></div>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script>
    const session = requireAuth();
    if (session) wireDashboardLink(session);

    const params = new URLSearchParams(window.location.search);
    const petId = params.get("id");
    if (!petId) window.location.href = "/home";

    document.getElementById("backLink").href = `/petDetail?id=${petId}`;

    async function loadHistory() {
      const res = await fetch(`${API_BASE}/GetMedicalRecord/${petId}`);
      const records = await res.json();
      const list = document.getElementById("recordList");

      if (!records.length) {
        list.innerHTML = `
          <div class="empty-state">
            <i class="bi bi-emoji-smile d-block mb-2"></i>
            <p class="mb-0">No treatment history yet.</p>
          </div>`;
        return;
      }

      list.innerHTML = records.map(r => `
        <a href="/medicalRecord?id=${r.record_id}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
          <span>${r.diagnosis}</span>
          <small class="text-muted">${r.treatment_date ? new Date(r.treatment_date).toLocaleDateString() : "-"}</small>
        </a>
      `).join("");
    }

    loadHistory().catch(() => showAlert("alertBox", "Cannot reach server"));
  </script>
</body>
</html>
