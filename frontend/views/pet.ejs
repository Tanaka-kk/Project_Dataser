<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('partials/head', { title: 'Pet Details' }) %>
</head>
<body class="bg-body-tertiary">
  <%- include('partials/navbar', { active: 'pet' }) %>

  <div class="container pb-5" style="max-width: 560px;">
    <a href="/home" id="backLink" class="text-decoration-none text-muted d-inline-block mb-3">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
    <div class="card page-card p-4">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="pet-avatar" style="width:56px;height:56px;font-size:1.7rem;">🐾</div>
        <h4 class="mb-0">Pet Details</h4>
      </div>
      <div id="alertBox" class="alert d-none"></div>

      <form id="petForm">
        <div class="mb-3">
          <label class="form-label">Pet Name</label>
          <input type="text" class="form-control" id="petName" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Species</label>
          <input type="text" class="form-control" id="species" required>
        </div>
        <div class="row">
          <div class="col-6 mb-3">
            <label class="form-label">Blood Type</label>
            <input type="text" class="form-control" id="bloodtype">
          </div>
          <div class="col-6 mb-3">
            <label class="form-label">Weight (kg)</label>
            <input type="number" step="0.01" min="0" class="form-control" id="weight">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Birth Date</label>
          <input type="date" class="form-control" id="birthDate">
        </div>
        <div class="mb-4">
          <label class="form-label">Allergy</label>
          <textarea class="form-control" id="allergy" rows="2"></textarea>
        </div>
        <div class="d-flex justify-content-between">
          <button type="button" id="deleteBtn" class="btn btn-outline-danger px-4"><i class="bi bi-trash me-1"></i>Delete Pet</button>
          <button type="submit" class="btn btn-brand px-4"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script>
    const session = requireAuth();
    const params = new URLSearchParams(window.location.search);
    const petId = params.get("id");

    if (!petId) window.location.href = "/home";
    if (session) {
      wireDashboardLink(session);
      document.getElementById("backLink").href = `/petDetail?id=${petId}`;
    }

    async function loadPet() {
      const res = await fetch(`${API_BASE}/infopet/${petId}`);
      const pet = await res.json();

      document.getElementById("petName").value = pet.pet_name || "";
      document.getElementById("species").value = pet.species || "";
      document.getElementById("bloodtype").value = pet.bloodtype || "";
      document.getElementById("birthDate").value = pet.birth_date ? pet.birth_date.split("T")[0] : "";
      document.getElementById("weight").value = pet.weight || "";
      document.getElementById("allergy").value = pet.allergy || "";
    }

    document.getElementById("petForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const body = {
        pet_name: document.getElementById("petName").value,
        species: document.getElementById("species").value,
        bloodtype: document.getElementById("bloodtype").value,
        birth_date: document.getElementById("birthDate").value,
        weight: document.getElementById("weight").value,
        allergy: document.getElementById("allergy").value
      };

      const res = await fetch(`${API_BASE}/updatePet/${petId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (data.error) {
        showAlert("alertBox", data.message || "Failed to update pet");
        return;
      }
      showAlert("alertBox", "Pet updated successfully", "success");
    });

    document.getElementById("deleteBtn").addEventListener("click", async () => {
      if (!confirm("Delete this pet? This cannot be undone.")) return;

      const res = await fetch(`${API_BASE}/deletePet/${petId}`, { method: "DELETE" });
      const data = await res.json();

      if (data.error) {
        showAlert("alertBox", data.message || "Failed to delete pet");
        return;
      }
      window.location.href = "/home";
    });

    loadPet().catch(() => showAlert("alertBox", "Cannot reach server"));
  </script>
</body>
</html>
