<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('partials/head', { title: 'Admin' }) %>
</head>
<body class="bg-body-tertiary">
  <%- include('partials/navbar', { active: 'dashboard' }) %>

  <div class="container pb-5">
    <div class="card page-card p-4 mb-4">
      <h4 class="mb-0"><i class="bi bi-shield-lock-fill text-brand-dark me-2"></i>Admin Panel</h4>
      <p class="text-muted mb-0">Manage doctors, users and appointments.</p>
    </div>

    <div id="alertBox" class="alert d-none"></div>

    <!-- Doctors -->
    <div class="card page-card p-4 mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-heart-pulse me-2"></i>Doctors</h5>
        <button class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#addDoctorModal">
          <i class="bi bi-plus-lg me-1"></i>Add Doctor
        </button>
      </div>
      <div class="input-group input-group-sm mb-3">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" id="doctorSearch" placeholder="Search doctors...">
      </div>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr><th>Name</th><th>Specialization</th><th>Phone</th><th>Available</th><th></th></tr>
          </thead>
          <tbody id="doctorsTable"></tbody>
        </table>
      </div>
    </div>

    <!-- Users -->
    <div class="card page-card p-4 mb-4">
      <h5 class="mb-3"><i class="bi bi-people-fill me-2"></i>Users</h5>
      <div class="input-group input-group-sm mb-3">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" id="userSearch" placeholder="Search users...">
      </div>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr><th>Username</th><th>Full Name</th><th>Phone</th><th>Role</th><th>Joined</th></tr>
          </thead>
          <tbody id="usersTable"></tbody>
        </table>
      </div>
    </div>

    <!-- Appointments -->
    <div class="card page-card p-4">
      <h5 class="mb-3"><i class="bi bi-calendar-check-fill me-2"></i>All Appointments</h5>
      <div class="input-group input-group-sm mb-3">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" id="appointmentSearch" placeholder="Search appointments...">
      </div>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr><th class="col-narrow">Patient</th><th class="col-narrow">Pet</th><th class="col-narrow">Doctor</th><th>Reason</th><th>Status</th><th>Date</th><th>Time</th></tr>
          </thead>
          <tbody id="appointmentsTable"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add Doctor Modal -->
  <div class="modal fade" id="addDoctorModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Add Doctor</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="addDoctorForm">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Login Username</label>
              <input type="text" class="form-control" id="docUsername" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Login Password</label>
              <input type="password" class="form-control" id="docPassword" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Doctor Name</label>
              <input type="text" class="form-control" id="docName" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Specialization</label>
              <input type="text" class="form-control" id="docSpecialization" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Phone</label>
              <input type="text" class="form-control" id="docPhone">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-brand">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Edit Doctor Modal -->
  <div class="modal fade" id="editDoctorModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Doctor</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="editDoctorForm">
          <div class="modal-body">
            <input type="hidden" id="editDocId">
            <div class="mb-3">
              <label class="form-label">Doctor Name</label>
              <input type="text" class="form-control" id="editDocName" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Specialization</label>
              <input type="text" class="form-control" id="editDocSpecialization" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Phone</label>
              <input type="text" class="form-control" id="editDocPhone">
            </div>
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="editDocAvailable">
              <label class="form-check-label" for="editDocAvailable">Available</label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-brand">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    const session = requireRole("admin");
    let addDoctorModal, editDoctorModal;
    let allDoctors = [], allUsers = [], allAppointments = [];

    async function loadDoctors() {
      const res = await fetch(`${API_BASE}/GetDoctors`);
      allDoctors = await res.json();
      renderDoctors(allDoctors);
    }

    function renderDoctors(doctors) {
      document.getElementById("doctorsTable").innerHTML = doctors.map(d => `
        <tr>
          <td>${d.doc_name}</td>
          <td>${d.specialization}</td>
          <td>${d.phone || "-"}</td>
          <td>${d.is_available ? '<span class="badge text-bg-success">Yes</span>' : '<span class="badge text-bg-secondary">No</span>'}</td>
          <td>
            <div class="d-flex gap-2">
              <button class="btn btn-outline-secondary btn-sm" onclick='openEditDoctor(${JSON.stringify(d)})'>
                <i class="bi bi-pencil"></i>
              </button>
              <button class="btn btn-outline-danger btn-sm" onclick="deleteDoctor('${d.doc_id}')">
                <i class="bi bi-trash"></i>
              </button>
            </div>
          </td>
        </tr>
      `).join("") || `<tr><td colspan="5" class="text-muted text-center py-3">No doctors found.</td></tr>`;
    }

    async function loadUsers() {
      const res = await fetch(`${API_BASE}/users`);
      allUsers = await res.json();
      renderUsers(allUsers);
    }

    function renderUsers(users) {
      document.getElementById("usersTable").innerHTML = users.map(u => `
        <tr>
          <td>${u.username}</td>
          <td>${u.full_name || "-"}</td>
          <td>${u.phone || "-"}</td>
          <td><span class="badge text-bg-light border">${u.role}</span></td>
          <td>${new Date(u.created_at).toLocaleDateString()}</td>
        </tr>
      `).join("") || `<tr><td colspan="5" class="text-muted text-center py-3">No users found.</td></tr>`;
    }

    async function loadAppointments() {
      const res = await fetch(`${API_BASE}/GetAllAppointments`);
      allAppointments = await res.json();
      renderAppointments(allAppointments);
    }

    function renderAppointments(rows) {
      document.getElementById("appointmentsTable").innerHTML = rows.map(a => {
        const past = isPastDate(a.app_date);
        return `
        <tr class="${past ? "opacity-50" : ""}">
          <td>${a.username}</td>
          <td>${a.pet_name}</td>
          <td>${a.doc_name}</td>
          <td><div class="cell-wrap">${a.reason || "-"}</div></td>
          <td>${a.status || "Pending"} ${past ? '<span class="badge text-bg-secondary ms-1">Past</span>' : ""}</td>
          <td>${a.app_date ? new Date(a.app_date).toLocaleDateString() : "-"}</td>
          <td>${a.app_time || "-"}</td>
        </tr>
      `;
      }).join("") || `<tr><td colspan="7" class="text-muted text-center py-3">No appointments found.</td></tr>`;
    }

    async function deleteDoctor(doc_id) {
      if (!confirm("Delete this doctor? This also removes their login.")) return;

      const res = await fetch(`${API_BASE}/deleteDoctor/${doc_id}`, { method: "DELETE" });
      const data = await res.json();

      if (data.error) {
        showAlert("alertBox", data.message || "Failed to delete doctor");
        return;
      }

      loadDoctors();
      loadUsers();
    }

    document.getElementById("doctorSearch").addEventListener("input", (e) => {
      const q = e.target.value.trim().toLowerCase();
      renderDoctors(allDoctors.filter(d =>
        d.doc_name.toLowerCase().includes(q) || d.specialization.toLowerCase().includes(q)
      ));
    });

    document.getElementById("userSearch").addEventListener("input", (e) => {
      const q = e.target.value.trim().toLowerCase();
      renderUsers(allUsers.filter(u =>
        u.username.toLowerCase().includes(q) || (u.full_name || "").toLowerCase().includes(q)
      ));
    });

    document.getElementById("appointmentSearch").addEventListener("input", (e) => {
      const q = e.target.value.trim().toLowerCase();
      renderAppointments(allAppointments.filter(a =>
        a.username.toLowerCase().includes(q) ||
        a.pet_name.toLowerCase().includes(q) ||
        a.doc_name.toLowerCase().includes(q)
      ));
    });

    function openEditDoctor(doctor) {
      document.getElementById("editDocId").value = doctor.doc_id;
      document.getElementById("editDocName").value = doctor.doc_name;
      document.getElementById("editDocSpecialization").value = doctor.specialization;
      document.getElementById("editDocPhone").value = doctor.phone || "";
      document.getElementById("editDocAvailable").checked = !!doctor.is_available;
      editDoctorModal.show();
    }

    document.getElementById("addDoctorForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const body = {
        username: document.getElementById("docUsername").value,
        password: document.getElementById("docPassword").value,
        doc_name: document.getElementById("docName").value,
        specialization: document.getElementById("docSpecialization").value,
        phone: document.getElementById("docPhone").value
      };

      const res = await fetch(`${API_BASE}/admin/addDoctor`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (data.error) {
        showAlert("alertBox", data.message || "Failed to add doctor");
        return;
      }

      addDoctorModal.hide();
      document.getElementById("addDoctorForm").reset();
      loadDoctors();
      loadUsers();
    });

    document.getElementById("editDoctorForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const doc_id = document.getElementById("editDocId").value;
      const body = {
        doc_name: document.getElementById("editDocName").value,
        specialization: document.getElementById("editDocSpecialization").value,
        phone: document.getElementById("editDocPhone").value,
        is_available: document.getElementById("editDocAvailable").checked
      };

      const res = await fetch(`${API_BASE}/updateDoctor/${doc_id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (data.error) {
        showAlert("alertBox", data.message || "Failed to update doctor");
        return;
      }

      editDoctorModal.hide();
      loadDoctors();
    });

    addDoctorModal = new bootstrap.Modal(document.getElementById("addDoctorModal"));
    editDoctorModal = new bootstrap.Modal(document.getElementById("editDoctorModal"));
    Promise.all([loadDoctors(), loadUsers(), loadAppointments()])
      .catch(() => showAlert("alertBox", "Cannot reach server"));
  </script>
</body>
</html>
