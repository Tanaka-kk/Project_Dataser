<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('partials/head', { title: 'Doctor' }) %>
</head>
<body class="bg-body-tertiary">
  <%- include('partials/navbar', { active: 'dashboard' }) %>

  <div class="container pb-5">
    <div class="card page-card p-4 mb-4">
      <h4 class="mb-0"><i class="bi bi-heart-pulse-fill text-brand-dark me-2"></i>Doctor Panel</h4>
      <p class="text-muted mb-0">Your assigned appointments.</p>
    </div>

    <div id="alertBox" class="alert d-none"></div>

    <div class="card page-card p-4">
      <h5 class="mb-3"><i class="bi bi-calendar-check-fill me-2"></i>My Appointments</h5>
      <div class="input-group input-group-sm mb-3">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" id="appointmentSearch" placeholder="Search by patient or pet...">
      </div>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr><th class="col-narrow">Patient</th><th class="col-narrow">Pet</th><th>Reason</th><th>Status</th><th>Date</th><th>Time</th><th></th></tr>
          </thead>
          <tbody id="appointmentsTable"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add Medical Record Modal -->
  <div class="modal fade" id="addRecordModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Add Medical Record</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="addRecordForm">
          <div class="modal-body">
            <input type="hidden" id="recordAppId">
            <div class="mb-3">
              <label class="form-label">Diagnosis</label>
              <textarea class="form-control" id="recordDiagnosis" rows="2" required></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">Treatment</label>
              <textarea class="form-control" id="recordTreatment" rows="2" required></textarea>
            </div>
            <div class="row">
              <div class="col-6 mb-3">
                <label class="form-label">Cost</label>
                <input type="number" step="0.01" class="form-control" id="recordCost">
              </div>
              <div class="col-6 mb-3">
                <label class="form-label">Treatment Date</label>
                <input type="date" class="form-control" id="recordDate" required>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Treatment Time</label>
              <input type="time" class="form-control" id="recordTime" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-brand">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    const session = requireRole("doctor");
    let addRecordModal;
    let allAppointments = [];

    async function loadAppointments() {
      const res = await fetch(`${API_BASE}/doctorAppointments/${session.doc_id}`);
      allAppointments = await res.json();
      renderAppointments(allAppointments);
    }

    function renderAppointments(rows) {
      document.getElementById("appointmentsTable").innerHTML = rows.map(a => {
        const past = isPastDate(a.app_date);
        return `
        <tr class="${past ? "opacity-50" : ""}">
          <td>${a.username}</td>
          <td>${a.pet_name}</td>
          <td><div class="cell-wrap">${a.reason || "-"}</div></td>
          <td>${a.status || "Pending"} ${past ? '<span class="badge text-bg-secondary ms-1">Past</span>' : ""}</td>
          <td>${a.app_date ? new Date(a.app_date).toLocaleDateString() : "-"}</td>
          <td>${a.app_time || "-"}</td>
          <td>
            <div class="d-flex gap-2">
              <a href="/petDetail?id=${a.pet_id}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clipboard2-pulse"></i></a>
              ${!a.status ? `<button class="btn btn-success btn-sm" onclick="acceptAppointment('${a.app_id}')"><i class="bi bi-check-lg"></i></button>` : ""}
              <button class="btn btn-brand btn-sm" onclick="openAddRecord('${a.app_id}')"><i class="bi bi-plus-lg"></i></button>
            </div>
          </td>
        </tr>
      `;
      }).join("") || `<tr><td colspan="7" class="text-muted text-center py-3">No appointments found.</td></tr>`;
    }

    document.getElementById("appointmentSearch").addEventListener("input", (e) => {
      const q = e.target.value.trim().toLowerCase();
      renderAppointments(allAppointments.filter(a =>
        a.username.toLowerCase().includes(q) || a.pet_name.toLowerCase().includes(q)
      ));
    });

    async function acceptAppointment(app_id) {
      const res = await fetch(`${API_BASE}/updateAppointmentStatus/${app_id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: "Confirmed" })
      });
      const data = await res.json();

      if (data.error) {
        showAlert("alertBox", data.message || "Failed to accept appointment");
        return;
      }

      loadAppointments();
    }

    function openAddRecord(app_id) {
      document.getElementById("addRecordForm").reset();
      document.getElementById("recordAppId").value = app_id;

      const now = new Date();
      const pad = (n) => String(n).padStart(2, "0");
      document.getElementById("recordDate").value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      document.getElementById("recordTime").value = `${pad(now.getHours())}:${pad(now.getMinutes())}`;

      addRecordModal.show();
    }

    document.getElementById("addRecordForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const app_id = document.getElementById("recordAppId").value;
      const body = {
        diagnosis: document.getElementById("recordDiagnosis").value,
        treatment_detail: document.getElementById("recordTreatment").value,
        cost: document.getElementById("recordCost").value || null,
        treatment_date: document.getElementById("recordDate").value,
        treatment_time: document.getElementById("recordTime").value
      };

      const res = await fetch(`${API_BASE}/insertMedRecord/${app_id}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (data.error) {
        showAlert("alertBox", data.message || "Failed to add record");
        return;
      }

      addRecordModal.hide();
      showAlert("alertBox", "Medical record added", "success");
    });

    addRecordModal = new bootstrap.Modal(document.getElementById("addRecordModal"));
    loadAppointments().catch(() => showAlert("alertBox", "Cannot reach server"));
  </script>
</body>
</html>
